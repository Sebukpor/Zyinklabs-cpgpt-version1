# Copy this to docker/.env and fill in real values.
# NEVER commit the real .env file -- it contains credentials.

# ---------------------------------------------------------------------------
# Experiment selection
# ---------------------------------------------------------------------------
# Must match a filename in configs/experiment/ (without .yaml)
EXPERIMENT_NAME=zyinklabs_bioage

# Metadata column to predict. chronological_age for the bioage experiment;
# condition_class for the disease experiment (see scripts/01_download_computage_bench.py
# for how ComputAgeBench's Condition/Class columns are renamed on import).
TARGET_COLUMN=chronological_age

# Which pretrained CpGPT backbone to download/start from.
# Version 1 uses "large" (~100M params) for the strongest production-quality
# result this pipeline can produce -- needs
# 24GB+ VRAM; the AWS setup in aws/launch_instance.sh defaults to g6e.xlarge (48GB)
# specifically to support this.
MODEL_NAME=large

# Where prepare_data reads its input from. Defaults to the ComputAgeBench training
# split downloaded by the download_computage_bench service -- only the benchmark
# split filename should ever be used for SOTA comparison (BENCHMARK_DATA below),
# never for training.
PREPARE_INPUT=/workspace/data/processed/computage/computage_train_merged.feather

# Ridge-regression feature selection (CpGPT FAQ best-practice for phenotype-targeted
# finetuning). Recommended for a serious run -- speeds up training and focuses the
# model on CpG sites with actual signal for the target. Leave unset/empty to use
# all available CpG sites (slower, not recommended for production). Only applies
# to numeric targets (chronological_age), not condition_class.
RIDGE_SELECT_TOP_N=20000

# ---------------------------------------------------------------------------
# Validation gate -- "successful" training is defined as:
#   training completes AND best val/condition_loss <= VAL_LOSS_THRESHOLD
# Tune this based on a few exploratory runs before relying on it as an
# unattended gate. Units match condition_decoder_loss in the experiment YAML
# (mae for bioage -> years of age error; ce for disease -> cross-entropy).
# ---------------------------------------------------------------------------
VAL_LOSS_THRESHOLD=5.0

# Set to true to run training + validation but never push to Hugging Face
# (useful while you're still tuning the threshold itself).
SKIP_PUSH=false

# ---------------------------------------------------------------------------
# Hugging Face Hub
# ---------------------------------------------------------------------------
# Write-access token from https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# e.g. zyinklabs/cpgpt-bioage-v1 -- created automatically if it doesn't exist
HF_REPO_ID=zyinklabs/cpgpt-bioage-v1

# Keep private until you've validated the model against published clocks
HF_PRIVATE=true

# ---------------------------------------------------------------------------
# AWS credentials (for downloading CpGPT's S3-hosted pretrained weights)
# These should be a scoped IAM user/role with only s3:GetObject on the
# CpGPT public bucket + whatever your own data lives in -- not your root keys.
# On EC2, prefer an attached IAM instance role over these env vars where possible
# (see aws/README.md) -- only set these if running outside EC2 or the role
# approach isn't available.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Benchmark vs. SOTA (used when running `docker compose run --profile benchmark benchmark`)
# Compares our finetuned checkpoint against Horvath, Hannum, PhenoAge, etc. using
# the official ComputAgeBench methodology, on the held-out benchmark split.
# ---------------------------------------------------------------------------
BENCHMARK_DATA=/workspace/data/processed/computage/computage_benchmark_merged.feather
BENCHMARK_OUT_DIR=/workspace/data/processed/benchmark_results

# ---------------------------------------------------------------------------
# Inference-only (used when running `docker compose run --profile inference inference`)
# ---------------------------------------------------------------------------
CHECKPOINT_PATH=
CONFIG_PATH=
INFERENCE_INPUT=
INFERENCE_OUTPUT=/workspace/data/processed/predictions.csv
