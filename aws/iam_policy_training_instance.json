{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CpGPTPublicBucketRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::cpgpt-lucascamillo-public",
        "arn:aws:s3:::cpgpt-lucascamillo-public/*"
      ]
    },
    {
      "Sid": "ZyinkLabsDataBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_YOUR_ZYINKLABS_DATA_BUCKET",
        "arn:aws:s3:::REPLACE_WITH_YOUR_ZYINKLABS_DATA_BUCKET/*"
      ]
    },
    {
      "Sid": "CloudWatchLogsForTrainingJob",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/zyinklabs/cpgpt-training*"
    }
  ]
}
